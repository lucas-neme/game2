{
 "game": "Frequência Zero",
 "repo": "lucas-neme/game2",
 "branch": "main",
 "scan": [
  "assets/"
 ],
 "exclude": [],
 "how_to_use": "One entry per graphic file of Frequência Zero (never Ashen Kingdoms). Runtime art: assets/production (atlases loaded by index.html; contract in production.json, v4.json, v5.json). Originals: assets/source. Every ChatGPT ZIP member individually: assets/review/chatgpt-import/<pack>/ (byte provenance in import-manifest.json). REVIEW is never deployed (.dockerignore). animation-index.json lists available and missing animations per character. Regenerate: python tools/assets/asset_tools.py registry && python tools/assets/asset_tools.py audit",
 "runtime_globs": [
  "index.html",
  "campaign.html"
 ],
 "reference_regex": "assets/[A-Za-z0-9_./-]+[.](?:png|webp|jpg|svg|gif)",
 "reference_bases": [
  ""
 ],
 "fact_manifests": [
  "assets/manifests/production.json",
  "assets/manifests/v4.json",
  "assets/manifests/v5.json"
 ],
 "frame_labels": [
  {
   "manifest": "assets/manifests/v5.json",
   "root_key": "npcs",
   "anims_key": "animations",
   "src_key": "source_frames",
   "path_regex": "npcs/([a-z_]+)/frames/r([0-9]+)_([0-9]+)[.]png$"
  }
 ],
 "default_license": "Frequência Zero original art (project owner; generated for the project)",
